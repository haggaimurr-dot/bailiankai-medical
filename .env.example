APP_ENV=development
ENABLE_DEMO=true
# 仅服务端保存；同时留空时微信登录接口返回尚未配置。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
HTTP_ADDR=127.0.0.1:8080
DB_DSN=bailiankai:CHANGE_ME@tcp(127.0.0.1:3307)/bailiankai_dev?charset=utf8mb4&parseTime=true&loc=Asia%2FShanghai
TEST_DB_DSN=bailiankai:CHANGE_ME@tcp(127.0.0.1:3307)/bailiankai_test?charset=utf8mb4&parseTime=true&loc=Asia%2FShanghai
PENDING_CONFIRMATION_MINUTES=120

# 开发默认 local；正式图片存储显式设为 cos，不会在失败时回退本地。
MEDIA_DRIVER=local
MEDIA_ROOT=../../.local/private-media
# 桶创建后填写，必须私有、阻止公共访问并启用版本控制。
COS_BUCKET=
COS_REGION=
COS_PREFIX=private-media
COS_SECRET_ID=
COS_SECRET_KEY=
COS_SESSION_TOKEN=
# 备份进程专用配置及独立凭据放在独立密钥文件，见 deploy/media-backup.env.example。


# AI服务：全部留空时明确未配置；受控网关协议见 docs/AI辅助评估服务端与验收.md。
# HTTPS远程网关须配置密钥；仅本地测试允许loopback HTTP。
ASSESSMENT_GATEWAY_URL=
ASSESSMENT_GATEWAY_KEY=
ASSESSMENT_CHECKER_VERSION=
ASSESSMENT_THRESHOLD_PROFILE_VERSION=
ASSESSMENT_MODEL_PROVIDER=
ASSESSMENT_MODEL_ID=
ASSESSMENT_MODEL_VERSION=
ASSESSMENT_DEPLOYMENT_VERSION=
ASSESSMENT_PROMPT_VERSION=
ASSESSMENT_ADAPTER_VERSION=
