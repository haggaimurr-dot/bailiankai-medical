.pair { display:flex; gap:16rpx; margin:24rpx 0; }.pair > view { width:50%; }.pair image { width:100%; }.text { white-space:pre-wrap; margin:18rpx 0; line-height:1.7; }.meta { color:#64748b; font-size:24rpx; overflow-wrap:anywhere; }button { margin-top:20rpx; }

.filters input { margin:16rpx 0; padding:18rpx; background:#f4f6f9; border-radius:12rpx }.tag { display:inline-block; background:#edf5f5; color:#28756e; border-radius:8rpx; padding:6rpx 14rpx; margin:12rpx 10rpx 0 0; font-size:24rpx }.comparison { position:relative; height:480rpx; overflow:hidden; background:#f4f6f9 }.comparison-image { position:absolute; width:100%; height:480rpx; top:0; left:0 }.before-clip { position:absolute; top:0; left:0; overflow:hidden; height:480rpx }.divider { position:absolute; top:0; height:100%; width:4rpx; background:#fff }.comparison-before,.comparison-after { position:absolute; top:16rpx; padding:8rpx 16rpx; background:#ffffffdd; border-radius:8rpx; font-size:24rpx }.comparison-before { left:16rpx }.comparison-after { right:16rpx }
