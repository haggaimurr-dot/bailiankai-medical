.page{padding:32rpx}.heading{font-size:40rpx;font-weight:600;margin-bottom:24rpx}.description{color:#6b7785;font-size:26rpx;line-height:1.8}.card{padding:32rpx;margin:28rpx 0;background:#fff;border-radius:24rpx}.title{font-size:32rpx;font-weight:600}.status{color:#34776b;margin:20rpx 0}.error{color:#b33b3b;margin:24rpx 0}button{margin-top:20rpx;font-size:28rpx}
.unread-badge { display: inline-block; margin-left: 12rpx; padding: 2rpx 12rpx; border-radius: 999rpx; background: #dc2626; color: #fff; font-size: 22rpx; font-weight: 700; }
.inbox-row { display: flex; gap: 12rpx; padding: 20rpx 0; border-top: 2rpx solid #eee; }
.inbox-row:first-of-type { border-top: 0; }
.inbox-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #dc2626; margin-top: 10rpx; flex: none; }
.inbox-main { flex: 1; min-width: 0; }
.inbox-title { font-size: 28rpx; font-weight: 600; }
.inbox-body { font-size: 26rpx; color: #617188; line-height: 1.7; margin-top: 4rpx; }
.inbox-arrow { color: #999; font-size: 32rpx; flex: none; }
