.list-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.identity-note { margin-top: 20rpx; color: #617188; font-size: 22rpx; }
.filter-scroll { margin: 28rpx 0 16rpx; white-space: nowrap; }
.status-filters { display: inline-flex; gap: 12rpx; padding-bottom: 8rpx; }
.status-chip { flex-shrink: 0; min-height: 88rpx; margin: 0; padding: 14rpx 24rpx; border: 1rpx solid #d7dee8; border-radius: 20rpx; color: #617188; background: #fff; font-size: 26rpx; line-height: 58rpx; }
.status-chip::after { border: 0; }
.status-chip-active { border-color: #1763c6; color: #fff; background: #1763c6; }
.pending-recovery { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 24rpx; padding: 20rpx 24rpx; border-color: #e8c995; background: #fffcf5; }
.recovery-description { font-size: 24rpx; }
.record-count { margin-bottom: 18rpx; color: #617188; font-size: 24rpx; }
.appointment-card { margin-bottom: 24rpx; }
.appointment-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.appointment-doctor { font-size: 34rpx; font-weight: 600; }
.appointment-time { margin: 18rpx 0 8rpx; font-size: 28rpx; font-weight: 600; }
.appointment-deadline { margin-top: 20rpx; color: #8a5200; font-size: 24rpx; }
.appointment-reason { margin-top: 20rpx; color: #b42318; font-size: 24rpx; }
.appointment-footer { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #eef2f6; }
.appointment-footer .meta { flex: 1; font-size: 22rpx; }
