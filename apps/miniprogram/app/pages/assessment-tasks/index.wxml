<view class="page tasks-page"><view class="eyebrow">MY ASSESSMENTS</view><view class="title">{{selected ? '评估任务' : '我的评估'}}</view><view wx:if="{{error}}" class="inline-error">{{error}}</view><t-button wx:if="{{needsLogin}}" theme="primary" block bind:tap="login">前往登录</t-button><block wx:elif="{{selected}}"><view class="card"><view class="status">{{label}}</view><view class="meta task-id">{{selected.task.id}}</view><view class="subtitle">分析尝试 {{selected.task.attemptCount}} / {{selected.task.maxAttempts}}</view><view wx:if="{{selected.task.status === 'awaiting_review'}}" class="subtitle">分析完成，待医生复核。复核后可查看观察内容及建议。</view><view wx:if="{{selected.task.status === 'retry_wait'}}" class="subtitle">服务暂时不可用，系统将在稍后自动重试。</view><view wx:if="{{selected.task.failureCode}}" class="subtitle">{{failureMessage}}</view><view wx:if="{{selected.task.status === 'cancelled'}}" class="subtitle">任务已取消。可以重新准备照片发起评估。</view><view wx:for="{{selected.photos}}" wx:key="id" class="subtitle">{{item.angle === 'front' ? '正面' : item.angle === 'left' ? '本人左侧' : '本人右侧'}} · {{item.qualityCheck.status === 'passed' ? '质检通过' : item.qualityCheck.status === 'pending' ? '等待检查' : item.qualityCheck.status === 'rejected' ? '请补拍' : '检查暂不可用'}}</view></view><view class="card"><t-button wx:if="{{selected.task.status === 'draft'}}" theme="primary" block disabled="{{busy || pending}}" bind:tap="prepare">继续准备照片</t-button><t-button wx:if="{{selected.task.status === 'failed' && selected.task.retryable && selected.task.attemptCount < selected.task.maxAttempts}}" theme="primary" block disabled="{{busy || pending}}" data-action="retry" bind:tap="action">重试分析</t-button><t-button wx:if="{{selected.task.status === 'completed' || selected.task.status === 'rejected'}}" theme="primary" block bind:tap="result">查看结果 / 医生说明</t-button><t-button wx:if="{{selected.task.status === 'rejected' || selected.task.status === 'failed' || selected.task.status === 'cancelled'}}" theme="default" block disabled="{{busy || pending}}" bind:tap="retake">重新准备照片</t-button><t-button wx:if="{{selected.task.status !== 'cancelled'}}" theme="danger" variant="text" block disabled="{{busy || pending}}" data-action="cancel" bind:tap="action">取消任务</t-button><t-button wx:if="{{selected.consent.granted}}" theme="danger" variant="text" block disabled="{{busy || pending}}" data-action="consent" bind:tap="action">撤回AI用途授权</t-button><t-button wx:if="{{pending}}" theme="primary" block loading="{{busy}}" bind:tap="retryOperation">重试原操作</t-button></view><t-button theme="default" block bind:tap="back">返回全部任务</t-button></block><block wx:elif="{{!needsLogin}}"><picker range="{{filters}}" value="{{filter}}" bindchange="filterChanged"><view class="card filter">{{filters[filter]}} ▾</view></picker><view wx:for="{{tasks}}" wx:key="id" class="card task" data-id="{{item.id}}" bindtap="open"><view class="task-heading"><view class="status">{{item.label}}</view><text>查看 ›</text></view><view class="meta task-id">{{item.id}}</view><view class="meta">更新：{{item.time}} 北京时间</view></view><view wx:if="{{!tasks.length && !loading && !error}}" class="card state">暂无匹配任务</view><navigator url="/pages/assessment/index" class="card entry">＋ 开始新的评估</navigator></block><navigator url="/pages/schedule/index" class="footer-note">直接预约面诊 ›</navigator><view class="footer-note">照片辅助观察，具体以面诊为准。</view></view>