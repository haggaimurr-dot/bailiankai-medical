.tasks-page .card,.demo-banner { margin:24rpx 0; }.status { color:#1763c6; font-size:30rpx; font-weight:600; }.task-id { overflow-wrap:anywhere; margin:12rpx 0; }.task-heading,.filter { display:flex; justify-content:space-between; align-items:center; }.task-heading text,.filter text { color:#1763c6; font-size:24rpx; }.progress { display:grid; grid-template-columns:repeat(4,1fr); gap:8rpx; margin:32rpx 0; font-size:21rpx; text-align:center; }.progress text { padding:14rpx 4rpx; border-top:6rpx solid #e3eaf2; color:#8795a6; }.progress .active { border-color:#1763c6; color:#1763c6; }.simulation t-button { display:block; margin-top:24rpx; }.simulation .meta { margin-top:16rpx; }.entry { color:#1763c6; text-align:center; }
