.page-heading { display: flex; justify-content: space-between; align-items: flex-end; gap: 16rpx; }
.patient-name { color: #617188; font-size: 24rpx; }
.intro-copy { margin: 16rpx 0 28rpx; color: #617188; font-size: 25rpx; line-height: 1.7; }
.record-count { margin: 0 0 18rpx 48rpx; color: #617188; font-size: 23rpx; }
.timeline-row { display: flex; align-items: stretch; gap: 18rpx; }
.timeline-rail { width: 22rpx; flex: 0 0 22rpx; display: flex; flex-direction: column; align-items: center; }
.timeline-dot { width: 16rpx; height: 16rpx; margin-top: 32rpx; border: 5rpx solid #dbeafe; border-radius: 50%; background: #1763c6; box-sizing: content-box; }
.timeline-line { flex: 1; width: 2rpx; min-height: 24rpx; background: #dce6f2; }
.record-card { flex: 1; min-width: 0; margin-bottom: 18rpx; }
.record-top { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.record-date { color: #304761; font-size: 27rpx; font-weight: 600; }
.record-doctor { margin-top: 18rpx; color: #304761; font-size: 31rpx; font-weight: 600; }
.record-meta { margin-top: 8rpx; color: #8391a5; font-size: 22rpx; }
.record-section { margin-top: 22rpx; padding-top: 18rpx; border-top: 1rpx solid #edf1f6; }
.section-label { color: #304761; font-size: 25rpx; font-weight: 600; }
.consultation-label { margin-top: 18rpx; }
.section-copy { margin-top: 10rpx; color: #617188; font-size: 24rpx; line-height: 1.7; white-space: pre-wrap; }
.task-line { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 16rpx; color: #617188; font-size: 23rpx; }
.task-line > view { min-width: 0; }
.task-date { display: block; margin-top: 6rpx; color: #8391a5; font-size: 21rpx; }
.partial-note { margin-top: 18rpx; color: #9a6b20; font-size: 22rpx; line-height: 1.6; }
.record-footer { display: flex; justify-content: flex-end; margin-top: 18rpx; }
.state-copy { margin: 12rpx 0 22rpx; color: #617188; font-size: 24rpx; line-height: 1.7; }
.inline-error { margin-top: 18rpx; padding: 18rpx; color: #b42318; background: #fff4f3; font-size: 23rpx; }

.advice-copy { white-space: pre-wrap; margin-bottom: 20rpx; }
.read-confirmed { color: #23845c; font-size: 24rpx; margin-top: 16rpx; }
