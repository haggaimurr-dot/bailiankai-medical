<view class="page">
  <view class="title">皮肤科普</view><view class="subtitle">了解知识，为面诊沟通做好准备</view>
  <view class="search-bar"><input value="{{query}}" bindinput="input" bindconfirm="search" confirm-type="search" maxlength="100" placeholder="搜索标题、摘要或正文" disabled="{{busy}}"/><button bindtap="search" disabled="{{busy}}">搜索</button></view>
  <button class="favorites-toggle" bindtap="toggleFavorites" disabled="{{busy}}">{{favorites ? '查看全部科普' : '查看我的收藏'}}</button>
  <view wx:if="{{clinics.length}}" class="card"><picker range="{{clinics}}" range-key="name" value="{{clinicIndex}}" bindchange="changeClinic" disabled="{{busy}}"><view>当前院区：{{clinics[clinicIndex].name}} ⌄</view></picker></view>
  <scroll-view scroll-x class="categories"><button class="category {{!categoryId ? 'active' : ''}}" bindtap="changeCategory">全部</button><button wx:for="{{categories}}" wx:key="id" class="category {{categoryId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="changeCategory">{{item.name}}</button></scroll-view>
  <view wx:if="{{loading}}" class="card state"><t-loading text="正在读取科普内容" layout="vertical" /></view>
  <view wx:if="{{error}}" class="card state"><view class="state-description">{{error}}</view><t-button theme="primary" bind:tap="retry">重新加载</t-button></view>
  <view wx:for="{{rows}}" wx:key="id" class="card article" data-id="{{item.id}}" bindtap="open" aria-role="button" aria-label="阅读{{item.title}}"><view class="section-title">{{item.title}}</view><view class="subtitle">{{item.summary}}</view><view class="meta">审核：{{item.reviewerName}}</view><view class="read-link">阅读全文 ›</view></view>
  <view wx:if="{{needsLogin}}" class="card state">登录后查看账号收藏<navigator url="/pages/profile/index" class="read-link">前往我的资料登录 ›</navigator></view>
  <view wx:if="{{!loading && !error && !needsLogin && !rows.length}}" class="card state">{{keyword ? '没有找到匹配文章，试试其他关键词' : favorites ? '当前院区暂无可阅读的收藏文章' : '暂无已发布科普内容'}}</view>
  <view wx:if="{{rows.length}}" class="meta">{{favorites ? '我的收藏' : '科普文章'}} · 共 {{total}} 篇</view>
  <t-button wx:if="{{rows.length < total}}" block variant="outline" loading="{{busy}}" bind:tap="more">加载更多</t-button>
  <view class="footer-note">科普内容用于了解知识，个人诊疗安排以医生面诊为准。</view>
</view>
