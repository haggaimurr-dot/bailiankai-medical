<view class="page">
  <view wx:if="{{loading}}" class="card state"><t-loading text="正在读取文章" layout="vertical" /></view>
  <view wx:elif="{{error}}" class="card state"><view class="state-title">文章暂不可用</view><view class="state-description">{{error}}</view><t-button theme="primary" bind:tap="retry">重新加载</t-button></view>
  <block wx:elif="{{article}}"><view class="card"><view class="title">{{article.title}}</view><view class="subtitle">{{article.summary}}</view><view class="meta">审核：{{article.reviewerName}} · {{reviewedDate}}</view><view class="meta">发布：{{publishedDate}}（北京时间）</view><text class="article-body" selectable>{{article.body}}</text><block wx:if="{{article.videoUrl}}"><view class="section-title">短视频科普</view><video src="{{article.videoUrl}}" controls show-play-btn enable-play-gesture class="quiz-video" /></block><block wx:if="{{article.quiz && article.quiz.length}}"><view class="section-title">看完测一测</view><view class="quiz-note">自测只做科普互动，帮助巩固刚学到的知识，不作任何诊断结论。</view><view wx:for="{{article.quiz}}" wx:for-index="qi" wx:for-item="q" class="quiz-q"><view class="quiz-question">{{qi + 1}}. {{q.question}}</view><view wx:for="{{q.options}}" wx:for-index="oi" wx:for-item="opt" class="quiz-opt {{quiz.answers[qi] === oi && !quiz.submitted ? 'picked' : ''}} {{quiz.submitted && oi === q.answerIndex ? 'correct' : ''}} {{quiz.submitted && quiz.answers[qi] === oi && oi !== q.answerIndex ? 'wrong' : ''}}" data-qi="{{qi}}" data-oi="{{oi}}" bindtap="answer"><text>{{opt}}</text><text wx:if="{{quiz.submitted && oi === q.answerIndex}}" class="quiz-mark ok"> ✔</text><text wx:if="{{quiz.submitted && quiz.answers[qi] === oi && oi !== q.answerIndex}}" class="quiz-mark bad"> ✘</text></view><view wx:if="{{quiz.submitted && q.explanation}}" class="quiz-explain">解析：{{q.explanation}}</view></view><view wx:if="{{quiz.submitted}}" class="quiz-result"><text>本次得分：{{quiz.score}} / {{article.quiz.length}}</text><t-button size="small" bind:tap="resetQuiz">再测一次</t-button></view><t-button wx:else block theme="primary" bind:tap="submitQuiz">提交自测</t-button></block><block wx:if="{{article.sourceText}}"><view class="section-title">参考来源</view><text class="article-body" selectable>{{article.sourceText}}</text></block><view class="footer-note">科普内容用于了解知识，个人诊疗安排以医生面诊为准。</view></view>
    <t-button wx:if="{{!demo}}" block theme="primary" variant="outline" loading="{{saving}}" disabled="{{loading || saving || favoriteError}}" bind:tap="toggleFavorite">{{saved ? '取消收藏' : '收藏文章'}}</t-button>
    <view wx:if="{{demo}}" class="meta">演示文章不支持账号收藏</view>
    <view wx:if="{{favoriteError}}" class="card state"><view>{{favoriteError}}</view><t-button bind:tap="retry">重新读取收藏状态</t-button></view>
    <navigator url="/pages/knowledge/index?favorites=1" class="collection-link">查看我的收藏 ›</navigator>
    <view wx:if="{{related.length}}" class="section-title">相关内容 · 同分类推荐</view>
    <view wx:for="{{related}}" wx:key="id" class="card related" data-id="{{item.id}}" bindtap="openRelated" aria-role="button"><view class="section-title">{{item.title}}</view><view class="subtitle">{{item.summary}}</view><view class="meta">审核：{{item.reviewerName}} · 阅读全文 ›</view></view>
    <view wx:if="{{relatedError}}" class="card state"><view>推荐内容暂不可用：{{relatedError}}</view><t-button bind:tap="retry">重新加载</t-button></view>
  </block>
</view>
