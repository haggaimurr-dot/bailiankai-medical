.assessment-page .card,.assessment-page .demo-banner { margin:24rpx 0; }.entry-link { display:flex; justify-content:space-between; }.entry-link text { color:#1763c6; font-size:24rpx; }.photo-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16rpx; margin:28rpx 0; }.sample { padding:28rpx 10rpx; border:2rpx dashed #cedaeb; border-radius:20rpx; text-align:center; background:#f7faff; }.sample.selected { background:#edf5ff; border-color:#1763c6; color:#1763c6; }.sample text { font-size:20rpx; }.face { font-size:64rpx; margin-bottom:12rpx; color:#7594b9; }.consent { display:flex; align-items:flex-start; gap:14rpx; margin-top:28rpx; font-size:24rpx; }
