.card{padding:30rpx;margin-bottom:24rpx}.copy{font-size:24rpx;line-height:1.8;color:#8191a5;margin-top:14rpx}.body{white-space:pre-wrap;font-size:28rpx;line-height:1.8;color:#304761}.task-heading{display:flex;justify-content:space-between;gap:16rpx;align-items:center}.task-card.selected{border-color:#1763c6;background:#f4f8ff}.status{font-size:22rpx;color:#527295}.status-alert,.overdue{color:#ba5d49}.overdue{font-size:22rpx;margin-top:10rpx}.field-label{font-size:25rpx;font-weight:600;color:#526a86;margin:28rpx 0 16rpx}.picker{padding:22rpx;background:#f6f8fb;border-radius:12rpx;font-size:26rpx;display:flex;justify-content:space-between}.picker text{color:#8391a5}.symptoms-input{box-sizing:border-box;width:100%;min-height:220rpx;font-size:26rpx;line-height:1.8;border:1rpx solid #dce3ee;border-radius:12rpx;padding:18rpx}.concern{display:flex;align-items:center;justify-content:space-between;margin-top:20rpx;font-size:24rpx}.photo-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx;margin:20rpx 0 32rpx}.photo-preview,.photo-placeholder{width:100%;height:180rpx;background:#f5f7fa;border-radius:8rpx;margin-bottom:12rpx}.photo-placeholder{display:flex;align-items:center;justify-content:center;color:#9cabbc;font-size:24rpx}.review{padding-top:28rpx;border-top:1rpx solid #edf1f6;margin-top:28rpx}.review-response{margin-top:16rpx}.notice{color:#4c8069;background:#f1f8f5;padding:18rpx;font-size:24rpx;margin-top:20rpx}.attention{background:#fff5ed;color:#a06543;padding:18rpx;font-size:24rpx;line-height:1.8}.pagination{display:flex;gap:20rpx;justify-content:center;align-items:center;font-size:24rpx;margin-bottom:24rpx}.consent{margin-top:14rpx}.inline-error{padding:20rpx;margin-bottom:20rpx;background:#fff4f3;color:#bc5f59;font-size:24rpx;line-height:1.8}.state{text-align:center;padding:48rpx}.symptoms-result{margin:14rpx 0}
.revision-history{margin-top:24rpx;border-top:1rpx solid #edf1f6}.revision-entry{padding:18rpx 0;border-top:1rpx solid #edf1f6;font-size:23rpx;color:#304761}.revision-entry .body{font-size:24rpx}
