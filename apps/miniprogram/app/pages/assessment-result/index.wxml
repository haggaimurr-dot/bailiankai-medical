<view class="page result-page"><view class="eyebrow">DOCTOR REVIEWED OBSERVATION</view><view class="title">辅助评估结果</view><view wx:if="{{error}}" class="inline-error">{{error}}</view><t-button wx:if="{{needsLogin}}" theme="primary" block bind:tap="login">前往登录</t-button><view wx:elif="{{review}}" class="card"><view class="section-title">{{review.decision === 'rejected' ? '请补充照片或预约面诊' : '经医生复核的辅助观察'}}</view><view class="meta">{{review.doctorName}} · {{time}} 北京时间 · 复核版本 {{review.version}}</view><block wx:if="{{review.finalContent}}"><view class="section-title">观察概要</view><view>{{review.finalContent.summary}}</view><view class="section-title">可见现象</view><view wx:for="{{review.finalContent.observations}}" wx:key="id" class="subtitle">{{item.description}}</view><view class="section-title">观察局限</view><view wx:for="{{review.finalContent.limitations}}" wx:key="*this" class="subtitle">{{item}}</view><view class="section-title">面诊建议</view><view>{{review.finalContent.consultationAdvice.reason}}</view><view wx:for="{{review.finalContent.consultationAdvice.preparation}}" wx:key="*this" class="subtitle">{{item}}</view></block><view class="section-title">医生说明</view><view>{{review.note}}</view><t-button wx:if="{{review.decision === 'rejected'}}" theme="primary" block bind:tap="retake">重新准备照片</t-button></view><view wx:else class="card"><view class="status">{{label}}</view><view class="subtitle">暂无经医生复核的结果，请查看任务进度。</view></view><t-button theme="default" block bind:tap="task">查看任务进度</t-button><navigator url="/pages/schedule/index" class="footer-note">预约面诊 ›</navigator><view class="footer-note">照片辅助观察，具体以面诊为准。</view></view>