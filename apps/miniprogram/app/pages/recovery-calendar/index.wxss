.summary { display: flex; justify-content: space-around; margin: 28rpx 0; padding: 24rpx 0; border-radius: 24rpx; background: #eaf2fe; }
.summary > view { display: flex; flex-direction: column; align-items: center; color: #617188; font-size: 23rpx; }
.count { color: #1763c6; font-size: 40rpx; font-weight: 600; }
.pending-count { color: #a56616; }
.calendar { padding: 24rpx 16rpx; }
.month-nav, .calendar-tools { display: flex; align-items: center; justify-content: space-between; }
.month-arrow, .today-link, .day { margin: 0; padding: 0; border-radius: 16rpx; background: transparent; }
.month-arrow::after, .today-link::after, .day::after { border: 0; }
.month-arrow { width: 72rpx; line-height: 72rpx; color: #1763c6; font-size: 44rpx; }
.calendar-tools { margin: 8rpx 16rpx 16rpx; color: #617188; font-size: 22rpx; }
.today-link { color: #1763c6; font-size: 23rpx; line-height: 48rpx; }
.week-grid, .day-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4rpx; }
.weekday { text-align: center; color: #8391a5; font-size: 23rpx; padding: 8rpx 0; }
.day { width: 100%; height: 82rpx; line-height: 48rpx; color: #304761; font-size: 27rpx; }
.outside { color: #aab5c4; }
.is-today { background: #eff6ff; color: #1763c6; font-weight: 600; }
.is-selected { background: #1763c6; color: #fff; }
.dots { display: flex; justify-content: center; gap: 5rpx; height: 16rpx; align-items: center; }
.dot { display: inline-block; width: 9rpx; height: 9rpx; border-radius: 50%; }
.task-dot { background: #71a4e4; }
.pending-dot { background: #e5a333; }
.review-dot { background: #39a992; }
.legend { display: flex; justify-content: center; gap: 20rpx; margin-top: 20rpx; color: #617188; font-size: 21rpx; }
.legend .dot { margin-right: 8rpx; }
.empty { padding: 40rpx 24rpx; text-align: center; }
.empty .meta { margin-top: 12rpx; }
.event-card { margin-bottom: 18rpx; }
.event-top { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10rpx; font-size: 22rpx; }
.event-kind { color: #1763c6; }
.kind-feedback { color: #617188; }
.kind-review { color: #218774; }
.event-status { color: #617188; }
.event-title { margin: 12rpx 0 6rpx; font-size: 29rpx; font-weight: 600; }
.event-content { margin: 18rpx 0; font-size: 26rpx; line-height: 1.75; white-space: pre-wrap; overflow-wrap: break-word; }
.overdue { margin: 10rpx 0; color: #a56616; font-size: 23rpx; }
.event-card t-button { display: block; margin-top: 18rpx; }
.pending-row { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.pending-row > view { min-width: 0; flex: 1; }
.range-note { margin-top: 24rpx; }
.scope-tabs { display: flex; gap: 12rpx; margin-bottom: 18rpx; }
.scope-tab { flex: 1; margin: 0; padding: 10rpx; line-height: 40rpx; font-size: 24rpx; color: #617188; background: #eff3f8; border-radius: 16rpx; }
.scope-tab::after { border: 0; }
.scope-tab.active { background: #eaf2fe; color: #1763c6; }
.comparison-picker { padding: 16rpx 0; color: #1763c6; font-size: 24rpx; overflow-wrap: break-word; }
.comparison-columns { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24rpx; margin-top: 16rpx; }
.comparison-columns > view { min-width: 0; }
.severity { font-size: 28rpx; font-weight: 600; }
.trend-result { margin: 20rpx 0; padding: 18rpx; background: #eff6ff; border-radius: 12rpx; color: #1763c6; }
