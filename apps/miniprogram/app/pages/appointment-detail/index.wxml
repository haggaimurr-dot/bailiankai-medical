<view class="page">
  <view class="demo-banner"><view class="demo-dot"></view><text>开发演示 · 本页展示当前患者账号的申请结果</text></view>
  <view wx:if="{{loading}}" class="card state"><t-loading theme="circular" text="正在读取最新预约状态" layout="vertical" /></view>
  <view wx:elif="{{expired}}" class="card state"><view class="state-title">登录已失效</view><view class="state-description">{{error}}</view><t-button theme="primary" block loading="{{creatingIdentity}}" bind:tap="newIdentity">重新登录</t-button></view>
  <view wx:elif="{{error}}" class="card state"><view class="state-title">无法读取预约详情</view><view class="state-description">{{error}}</view><t-button theme="primary" variant="outline" bind:tap="refresh">重新加载</t-button><view class="secondary-action"><t-button theme="primary" variant="text" bind:tap="openAppointments">返回我的预约</t-button></view></view>
  <block wx:elif="{{appointment}}">
    <view wx:if="{{appointment.slotStatus === 'closed'}}" class="card detail-card"><view class="section-title">原时段已停诊</view><view class="care-link-copy">{{appointment.suspensionReason || '工作人员将与您沟通新的就诊时间，请先确认改期安排。'}}</view></view>
    <view wx:if="{{appointment.status === 'confirmed' && !appointment.arrivedAt && appointment.slotStatus !== 'closed'}}" class="card detail-card"><view class="section-title">到院扫码签到</view><view class="care-link-copy">就诊当天领取签到码，向本院工作人员出示并核对预约。二维码 5 分钟有效。</view><t-button theme="primary" variant="outline" loading="{{checkInLoading}}" bind:tap="showCheckInCode">{{checkInImage ? '刷新签到码' : '显示签到码'}}</t-button><view wx:if="{{checkInError}}" class="action-notice">{{checkInError}}</view><view wx:if="{{checkInImage}}"><image src="{{checkInImage}}" mode="widthFix" style="width:280px;max-width:100%;display:block;margin:16px auto" /><view class="care-link-copy">有效至 {{checkInExpiry}}（北京时间）</view></view></view>
    <view wx:if="{{appointment.arrivedAt}}" class="card detail-card"><view class="section-title">已登记到诊</view><view class="care-link-copy">工作人员已核实到院，预约不可取消。</view></view>
    <view class="card result-card status-{{appointment.status}}"><t-tag theme="{{appointment.statusTheme}}" variant="light">{{appointment.statusLabel}}</t-tag><view class="result-title">{{appointment.statusLabel}}</view><view class="result-hint">{{appointment.statusHint}}</view><view wx:if="{{appointment.status === 'pending'}}" class="deadline">确认截止：{{appointment.deadlineLabel}}<text class="deadline-note">以服务端显示的截止时间为准，且不晚于时段开始。</text></view><view wx:if="{{appointment.status === 'rejected'}}" class="rejection-reason">拒绝原因：{{appointment.rejectionReason || '工作人员未确认本次申请'}}</view></view>
    <view class="card detail-card"><view class="section-title">到院安排</view><view class="detail-row"><text class="detail-label">医生</text><text class="detail-value">{{appointment.doctorName}}</text></view><view class="detail-row"><text class="detail-label">时间</text><text class="detail-value">{{appointment.timeLabel}}<text class="time-zone">北京时间</text></text></view><view class="detail-row"><text class="detail-label">院区</text><text class="detail-value">{{appointment.clinicName}}</text></view></view>
    <view wx:if="{{appointment.status === 'pending' || appointment.status === 'confirmed' || appointment.status === 'completed'}}" class="card detail-card care-links"><view class="section-title">面诊资料与方案</view><view class="care-link-copy">照片为选填资料；负责医生发布方案后，可在这里查看。</view><view class="care-link-actions"><t-button theme="primary" variant="outline" bind:tap="openPhotos">照片资料</t-button><t-button theme="primary" variant="outline" bind:tap="openCarePlan">治疗方案</t-button></view></view>
    <view class="card detail-card"><view class="section-title">治疗后随访</view><view class="care-link-copy">记录实际治疗后，会在这里显示随访任务和医护回评。</view><t-button theme="primary" variant="outline" bind:tap="openFollowups">查看随访任务</t-button></view>
    <view class="card detail-card"><view class="section-title">申请信息</view><view class="detail-row"><text class="detail-label">联系人</text><text class="detail-value">{{appointment.contactName}}</text></view><view class="detail-row"><text class="detail-label">手机号</text><text class="detail-value">{{appointment.contactPhone}}</text></view><view wx:if="{{appointment.note}}" class="detail-row"><text class="detail-label">备注</text><text class="detail-value">{{appointment.note}}</text></view><view class="detail-row"><text class="detail-label">提交时间</text><text class="detail-value">{{appointment.createdLabel}}</text></view><view class="detail-row"><text class="detail-label">申请编号</text><text class="detail-value appointment-id" selectable>{{appointment.id}}</text></view></view>
    <view class="card detail-card">
      <view class="section-title">预约状态时间线</view>
      <view wx:if="{{timelineError}}" class="state-description">{{timelineError}}<t-button variant="text" bind:tap="loadTimeline">重试加载历史</t-button></view>
      <view wx:elif="{{!timeline.length}}" class="meta">暂无历史记录</view>
      <block wx:else>
        <view wx:for="{{timeline}}" wx:key="id" class="timeline-event"><view class="timeline-title">{{item.label}}</view><view class="meta">{{item.timeLabel}} · 北京时间</view><view wx:if="{{item.detail}}" class="timeline-detail">{{item.detail}}</view></view>
      </block>
    </view>
    <view wx:if="{{appointment.canReschedule}}" class="secondary-action"><t-button theme="primary" variant="outline" block disabled="{{cancelling}}" bind:tap="openReschedule">{{appointment.status === 'waiting' ? '查询空位并申请转预约' : '申请改期'}}</t-button></view>
    <view wx:if="{{notice}}" class="action-notice">{{notice}}</view>
    <view wx:if="{{appointment.status === 'cancelled'}}" class="secondary-action"><t-button theme="primary" variant="outline" block bind:tap="openRebook">重新预约（{{appointment.doctorName}}）</t-button></view>
    <view class="detail-actions"><t-button theme="primary" block disabled="{{cancelling}}" bind:tap="refresh">刷新预约结果</t-button><view wx:if="{{appointment.cancellable}}" class="secondary-action"><t-button class="cancel-appointment" theme="danger" variant="outline" block loading="{{cancelling}}" bind:tap="cancelAppointment">取消预约</t-button></view></view>
    <view class="secondary-action"><t-button theme="primary" variant="text" bind:tap="openAppointments">查看我的预约</t-button></view>
    <view class="footer-note">尚未到诊或记录治疗且时段开始前，可取消候补、待确认或已确认预约。</view>
  </block>
</view>
