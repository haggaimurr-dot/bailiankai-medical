[mysqld]
basedir=/opt/bailiankai/mysql-8.4.11
datadir=/var/lib/bailiankai/mysql
socket=/run/bailiankai-mysql/mysql.sock
pid-file=/run/bailiankai-mysql/mysql.pid
bind-address=127.0.0.1
port=13307
mysqlx=OFF
skip-name-resolve
character-set-server=utf8mb4
collation-server=utf8mb4_0900_ai_ci
default-time-zone=+08:00
innodb-buffer-pool-size=128M
innodb-redo-log-capacity=100M
max-connections=40
performance-schema=OFF
local-infile=OFF
secure-file-priv=NULL
log-error=/var/log/bailiankai/mysql.log
