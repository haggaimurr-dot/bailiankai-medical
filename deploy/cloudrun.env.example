# Use private console environment variables; never upload the local .env.
APP_ENV=cloudrun
ENABLE_DEMO=false
HTTP_ADDR=0.0.0.0:8080
# Private MySQL address reachable from the same-region VPC.
DB_DSN=
MEDIA_DRIVER=cos
COS_BUCKET=
COS_REGION=ap-shanghai
COS_PREFIX=private-media
COS_SECRET_ID=
COS_SECRET_KEY=
COS_SESSION_TOKEN=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Remote browser origins need explicit HTTPS entries, separated by commas.
ADMIN_ALLOWED_ORIGINS=
